/target/
__pycache__/
# The sources that make bindings generates (binding design G-6).
/packages/ts/generated/
/packages/python/generated/
/packages/php-ext/generated/
/packages/ts/wasm/generated/
/packages/go/internal/ffi/generated/
# The Go files that binding owns in the Go module (binding GN-3); a release adds them to the commit of its Go tag
# (binding GN-15g, CK-19).
/packages/go/**/zz_generated_*.go
# The virtual environment, the wheels and the installed npm packages of the binding tests.
/var/
/node_modules/
# PHPUnit of composer.lock, which make install-php-tools installs.
/vendor/
# The release recipes that make release-recipes writes (binding GN-19h) and the folder of the npm platform packages that
# make release-npm-platform packs; both are generated.
/packages/release.mk
/packages/ts/npm/
